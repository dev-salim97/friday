# ./start.sh (or bash scripts/configure.sh) generates .env with unique local database/session secrets.
# Platform image: empty uses the GHCR release pinned in compose.yaml. Prefer an @sha256: digest when overriding.
# Slow ghcr.io links: MIRROR=ghcr.nju.edu.cn ./start.sh replaces the ghcr.io host and tags the image back. See README.zh-CN.md.
FRIDAY_IMAGE=
# Source build of this checkout (./start.sh dev writes this line; ./start.sh release removes it):
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
AGENTFLOW_HTTP_PORT=8090
AGENTFLOW_MYSQL_DSN=friday:REPLACE_ME@tcp(127.0.0.1:33315)/friday
AGENTFLOW_SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
AGENTFLOW_AUTH_REQUIRED=true
# Address reachable by WeCom users for account binding and notification links, e.g. https://friday.example.com
AGENTFLOW_PUBLIC_URL=
FRIDAY_DB_PASSWORD=REPLACE_ME
FRIDAY_DB_ROOT_PASSWORD=REPLACE_ME
FRIDAY_MYSQL_PORT=33315
# Optional public address reachable from execution containers/runners:
AGENTFLOW_PLATFORM_MCP_URL=
# Optional model IDs offered in the model picker (comma-separated):
AGENTFLOW_ASSISTANT_MODELS=
AGENTFLOW_ASSISTANT_MODEL=
# Optional path to administrator-verified SSH host keys. See docs/deployment.md.
AGENTFLOW_GIT_SSH_KNOWN_HOSTS=
# Worker separation, installed runners and preview settings retain AGENTFLOW_ names.
# See docs/deployment.md. Production HTTPS: AGENTFLOW_SECURE_COOKIES=true.
