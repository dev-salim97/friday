{
  "name": "friday-cli",
  "version": "0.2.3",
  "description": "Friday Local development workflows for Codex, Cursor, Claude Code, Pi, DeepSeek Harness and Hermes Agent",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "coding-agent",
    "codex",
    "claude-code",
    "cursor",
    "deepseek-harness",
    "hermes-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/Friday.git",
    "directory": "local"
  },
  "bugs": {
    "url": "https://github.com/Tencent/Friday/issues"
  },
  "homepage": "https://github.com/Tencent/Friday#readme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "friday": "bin/friday.mjs"
  },
  "files": [
    "bin/",
    "src/devflow_cli/",
    "skills/",
    ".codex/",
    ".cursor/",
    ".claude/",
    "hermes-plugin/",
    "dsh-plugin/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!skills/**/tests/**",
    "!.codex/**/tests/**",
    "!.cursor/**/tests/**",
    "!.claude/**/tests/**",
    "!**/.env",
    "!**/.env.*",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    "!.cursor/skills/agent-observability/logs/**",
    ".cursor/skills/agent-observability/logs/.gitkeep",
    "!.claude/skills/agent-observability/logs/**",
    ".claude/skills/agent-observability/logs/.gitkeep",
    "scripts/prepare-notices.py"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bash scripts/smoke-npm.sh",
    "pack:check": "npm pack --dry-run",
    "prepack": "python3 scripts/prepare-notices.py"
  },
  "publishConfig": {
    "access": "public"
  }
}
